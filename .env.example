AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for temporary credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# UI theme: default, apple, win95, or wow
APP_THEME=default

# Anthropic API key, used by the AI Debugger
CLAUDE_KEY=
# Model for the AI Debugger: opus (Opus 5.5, default), sonnet (Sonnet 5.5) or haiku (Haiku 5.5)
CLAUDE_MODEL=opus
